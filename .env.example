# EmailJS credentials — get these from https://dashboard.emailjs.com
# These are injected into the browser bundle by `npm run build:env`.
# NOTE: EmailJS client keys are public by design (they ship to the browser).
# Lock the service down with Allowed Origins in the EmailJS dashboard —
# do NOT rely on this file to keep them secret. Never put a private API key here.

EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=

# Optional: shown in the contact form's fallback "email me directly" link
CONTACT_FALLBACK_EMAIL=
